# Copy this file to .env and fill in production values before deploying.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=aikms
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Vault ────────────────────────────────────────────────────────────────────
VAULT_ENABLED=false
VAULT_HOST=localhost
VAULT_PORT=8200
VAULT_TOKEN=dev-root-token

# ─── OAuth2 / JWT ─────────────────────────────────────────────────────────────
OAUTH2_ISSUER_URI=http://localhost:8082

# ─── HSM ──────────────────────────────────────────────────────────────────────
HSM_PROVIDER=SIMULATOR
HSM_SIMULATOR_URL=http://localhost:8090

# ─── OPA ──────────────────────────────────────────────────────────────────────
OPA_URL=http://localhost:8181

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
